      "receiver": "Discord-MLOps",
      "object_matchers": [
        ["severity", "=", "warning"]
      ],
      "group_by": ["alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    }
  ],
